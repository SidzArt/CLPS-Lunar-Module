# Environment Configuration for CLPS Luna Browser Backend
# Copy to .env for local development

APP_ENV=development
DEBUG=true
PROJECT_NAME="CLPS Luna Browser API"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 18 + psycopg 3)
DATABASE_URL=postgresql+psycopg://clps_app:CHANGE_ME@localhost:5432/clps_luna

# Storage Paths
MEDIA_ROOT=./storage/media

# Security & Sessions
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
SESSION_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_STRING
SESSION_EXPIRE_HOURS=24

# CORS Settings (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# Public URL (for SEO canonical generation)
PUBLIC_BASE_URL="http://localhost:3000"

# Local AI Assist (Ollama)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma4:e4b"

# SPICE & DEM Directories (relative to backend/ or project root)
SPICE_KERNEL_DIR="../data/spice-kernels"
DEM_ROOT="../data/lunar-dem"

# Scientific Simulation Engine Settings (Phase 4)
SIM_LUNAR_REFERENCE_FRAME="MOON_ME"
SIM_ABERRATION_CORRECTION="LT+S"
SIM_DEFAULT_COARSE_INTERVAL_SECONDS=900
SIM_HORIZON_AZIMUTH_BINS=360
SIM_HORIZON_MAX_RADIUS_M=100000.0
SIM_OBSERVER_HEIGHT_M=1.5

# CODEX Hardware Settings
WIFI_BRIDGE_IP="192.168.1.101"
MOON_S3_IP="192.168.1.102"
CODEX_SHARED_SECRET=CHANGE_TO_HARDWARE_PRE_SHARED_KEY

